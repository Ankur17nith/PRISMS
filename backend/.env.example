# PRISMS Backend Environment Configuration Example
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://prisms_app:<db_password>@localhost:5433/prisms?schema=public"
DATABASE_URL_TEST="postgresql://prisms_app:<db_password>@localhost:5433/prisms_test?schema=public"
FRONTEND_URL="http://localhost:3000"

JWT_ACCESS_SECRET="replace-with-at-least-32-characters-secret-key-for-jwt"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Maximum thesis file upload size in bytes (default: 20 MiB = 20971520)
MAX_THESIS_FILE_SIZE_BYTES=20971520
THESIS_STORAGE_PATH="./storage/theses"

# Optional email domain filter (e.g. nith.ac.in)
# ALLOWED_EMAIL_DOMAIN="nith.ac.in"

# SMTP settings (leave empty for development console logging)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=2525
# SMTP_USER="user"
# SMTP_PASS="pass"
MAIL_FROM="PRISMS <no-reply@prisms.local>"
