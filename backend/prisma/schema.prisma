generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleScope {
  DEPARTMENT
  INSTITUTE
}

enum ThesisStatus {
  IN_PROGRESS
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FileScanStatus {
  PENDING
  CLEAN
  QUARANTINED
  FAILED
}

enum WorkflowStageStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum ReviewDecision {
  APPROVE
  REJECT
}

enum CommentType {
  REVIEW_COMMENT
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  collegeEmail  String        @unique @map("college_email")
  passwordHash  String?       @map("password_hash")
  fullName      String        @map("full_name")
  phone         String?
  accountStatus AccountStatus @default(PENDING) @map("account_status")

  emailVerifiedAt    DateTime? @map("email_verified_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  studentProfile Student?
  facultyProfile Faculty?
  userRoles      UserRole[]

  supervisorAssignmentsMade StudentSupervisorAssignment[] @relation("SupervisorAssignmentCreator")
  submissionsMade           ThesisSubmission[]            @relation("SubmissionCreator")
  filesUploaded             ThesisFile[]                  @relation("FileUploader")
  reviewsAssigned           ReviewAssignment[]            @relation("ReviewAssignee")
  reviewAssignmentsMade     ReviewAssignment[]            @relation("ReviewAssignmentCreator")
  commentsAuthored          ReviewComment[]               @relation("CommentAuthor")
  auditEvents               AuditEvent[]                  @relation("AuditActor")
  sessions                  Session[]
  tokens                    UserToken[]

  @@map("users")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students  Student[]
  faculty   Faculty[]
  userRoles UserRole[]

  @@map("departments")
}

model Student {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  rollNumber             String    @unique @map("roll_number")
  departmentId           String    @map("department_id") @db.Uuid
  program                String
  enrollmentDate         DateTime  @map("enrollment_date") @db.Date
  expectedCompletionDate DateTime? @map("expected_completion_date") @db.Date
  admissionStatus        String    @map("admission_status")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                  User                          @relation(fields: [userId], references: [id])
  department            Department                    @relation(fields: [departmentId], references: [id])
  thesis                Thesis?
  supervisorAssignments StudentSupervisorAssignment[]

  @@index([departmentId])
  @@map("students")
}

model Faculty {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeNumber String?  @unique @map("employee_number")
  departmentId   String   @map("department_id") @db.Uuid
  designation    String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user                User                          @relation(fields: [userId], references: [id])
  department          Department                    @relation(fields: [departmentId], references: [id])
  studentSupervisions StudentSupervisorAssignment[]

  @@index([departmentId])
  @@map("faculty")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  scopeType   RoleScope @map("scope_type")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  userRoles          UserRole[]
  reviewAssignments  ReviewAssignment[]
  workflowStageRoles WorkflowStageRole[]

  @@map("roles")
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  validFrom    DateTime  @default(now()) @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([userId, validUntil])
  @@index([roleId])
  @@index([departmentId])
  @@map("user_roles")
}

model StudentSupervisorAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  facultyId        String    @map("faculty_id") @db.Uuid
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  changeReason     String?   @map("change_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id])
  faculty    Faculty @relation(fields: [facultyId], references: [id])
  assignedBy User    @relation("SupervisorAssignmentCreator", fields: [assignedByUserId], references: [id])

  @@index([studentId, endDate])
  @@index([facultyId, endDate])
  @@map("student_supervisor_assignments")
}

model Thesis {
  id           String       @id @default(uuid()) @db.Uuid
  studentId    String       @unique @map("student_id") @db.Uuid
  workingTitle String       @map("working_title")
  abstract     String?
  researchArea String?      @map("research_area")
  status       ThesisStatus @default(IN_PROGRESS)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  student     Student            @relation(fields: [studentId], references: [id])
  submissions ThesisSubmission[]

  @@map("theses")
}

model ThesisSubmission {
  id                String           @id @default(uuid()) @db.Uuid
  thesisId          String           @map("thesis_id") @db.Uuid
  submissionNumber  Int              @map("submission_number")
  submittedByUserId String           @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime         @default(now()) @map("submitted_at")
  status            SubmissionStatus @default(SUBMITTED)
  overallDueAt      DateTime?        @map("overall_due_at")
  closedAt          DateTime?        @map("closed_at")
  closureReason     String?          @map("closure_reason")
  createdAt         DateTime         @default(now()) @map("created_at")

  thesis      Thesis            @relation(fields: [thesisId], references: [id])
  submittedBy User              @relation("SubmissionCreator", fields: [submittedByUserId], references: [id])
  files       ThesisFile[]
  stages      SubmissionStage[]
  comments    ReviewComment[]

  @@unique([thesisId, submissionNumber])
  @@index([status])
  @@index([submittedByUserId])
  @@map("thesis_submissions")
}

model ThesisFile {
  id               String         @id @default(uuid()) @db.Uuid
  submissionId     String         @map("submission_id") @db.Uuid
  uploadedByUserId String         @map("uploaded_by_user_id") @db.Uuid
  originalFilename String         @map("original_filename")
  storageKey       String         @unique @map("storage_key")
  mimeType         String         @map("mime_type")
  fileSizeBytes    BigInt         @map("file_size_bytes")
  sha256Checksum   String?        @map("sha256_checksum")
  scanStatus       FileScanStatus @default(PENDING) @map("scan_status")
  uploadedAt       DateTime       @default(now()) @map("uploaded_at")
  isPrimary        Boolean        @default(true) @map("is_primary")

  submission ThesisSubmission @relation(fields: [submissionId], references: [id])
  uploadedBy User             @relation("FileUploader", fields: [uploadedByUserId], references: [id])

  @@index([submissionId])
  @@index([uploadedByUserId])
  @@map("thesis_files")
}

model WorkflowStageDefinition {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  sequenceNumber   Int      @map("sequence_number")
  departmentScoped Boolean  @default(false) @map("department_scoped")
  isActive         Boolean  @default(true) @map("is_active")
  configuration    Json?    @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  submissionStages SubmissionStage[]
  requiredRoles    WorkflowStageRole[]

  @@map("workflow_stage_definitions")
}

model WorkflowStageRole {
  id                String   @id @default(uuid()) @db.Uuid
  stageDefinitionId String   @map("stage_definition_id") @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  isRequired        Boolean  @default(true) @map("is_required")
  createdAt         DateTime @default(now()) @map("created_at")

  stageDefinition WorkflowStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  role            Role                    @relation(fields: [roleId], references: [id])

  @@unique([stageDefinitionId, roleId])
  @@index([roleId])
  @@map("workflow_stage_roles")
}

model SubmissionStage {
  id                String              @id @default(uuid()) @db.Uuid
  submissionId      String              @map("submission_id") @db.Uuid
  stageDefinitionId String              @map("stage_definition_id") @db.Uuid
  status            WorkflowStageStatus @default(PENDING)
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  submission  ThesisSubmission        @relation(fields: [submissionId], references: [id])
  definition  WorkflowStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  assignments ReviewAssignment[]
  comments    ReviewComment[]

  @@unique([submissionId, stageDefinitionId])
  @@index([status])
  @@map("submission_stages")
}

model ReviewAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  submissionStageId String           @map("submission_stage_id") @db.Uuid
  reviewerUserId    String           @map("reviewer_user_id") @db.Uuid
  reviewerRoleId    String?          @map("reviewer_role_id") @db.Uuid
  assignedByUserId  String?          @map("assigned_by_user_id") @db.Uuid
  assignmentStatus  AssignmentStatus @default(ASSIGNED) @map("assignment_status")
  isRequired        Boolean          @default(true) @map("is_required")
  assignedAt        DateTime         @default(now()) @map("assigned_at")
  completedAt       DateTime?        @map("completed_at")
  assignmentNote    String?          @map("assignment_note")

  stage        SubmissionStage @relation(fields: [submissionStageId], references: [id])
  reviewer     User            @relation("ReviewAssignee", fields: [reviewerUserId], references: [id])
  reviewerRole Role?           @relation(fields: [reviewerRoleId], references: [id])
  assignedBy   User?           @relation("ReviewAssignmentCreator", fields: [assignedByUserId], references: [id])
  review       Review?
  comments     ReviewComment[]

  @@index([reviewerUserId, assignmentStatus])
  @@index([reviewerRoleId])
  @@index([submissionStageId])
  @@map("review_assignments")
}

model Review {
  id                 String         @id @default(uuid()) @db.Uuid
  reviewAssignmentId String         @unique @map("review_assignment_id") @db.Uuid
  decision           ReviewDecision
  summary            String?
  decidedAt          DateTime       @default(now()) @map("decided_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  assignment ReviewAssignment @relation(fields: [reviewAssignmentId], references: [id])

  @@map("reviews")
}

model ReviewComment {
  id                 String      @id @default(uuid()) @db.Uuid
  submissionId       String      @map("submission_id") @db.Uuid
  stageId            String?     @map("stage_id") @db.Uuid
  reviewAssignmentId String?     @map("review_assignment_id") @db.Uuid
  authorUserId       String      @map("author_user_id") @db.Uuid
  commentType        CommentType @default(REVIEW_COMMENT) @map("comment_type")
  body               String
  createdAt          DateTime    @default(now()) @map("created_at")
  editedAt           DateTime?   @map("edited_at")

  submission       ThesisSubmission  @relation(fields: [submissionId], references: [id])
  stage            SubmissionStage?  @relation(fields: [stageId], references: [id])
  reviewAssignment ReviewAssignment? @relation(fields: [reviewAssignmentId], references: [id])
  author           User              @relation("CommentAuthor", fields: [authorUserId], references: [id])

  @@index([submissionId, createdAt])
  @@index([stageId])
  @@index([reviewAssignmentId])
  @@map("review_comments")
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  eventType   String       @map("event_type")
  entityType  String       @map("entity_type")
  entityId    String?      @map("entity_id") @db.Uuid
  outcome     AuditOutcome
  reason      String?
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")
  metadata    Json?        @db.JsonB
  occurredAt  DateTime     @default(now()) @map("occurred_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([eventType, occurredAt])
  @@map("audit_events")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("user_tokens")
}
